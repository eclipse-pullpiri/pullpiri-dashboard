VITE_SETTING_SERVICE_API_URL=http://localhost:8080
VITE_SETTING_SERVICE_TIMEOUT=5000
VITE_LOG_SERVICE_URL=http://localhost:47097

# ---------------------------------------------------------------------------
# For Demo - node_name mapping read by the frontend (Demo.tsx)
#   Browser code can only read VITE_-prefixed variables, so they are declared as VITE_* below.
#   The value must match the "node_name reported by master" = the remote node's hostname.
#   (because install-agent.sh sets node_name to $(hostname))
#   If unset, Demo.tsx defaults (cloud-01/cloud-02, master=HPC) are used.
# The demo uses 2 clouds. Display name (label) vs REST nodeName(hostname):
#   "Cloud A" -> nodeName cloud-01,  "Cloud C" -> nodeName cloud-02
VITE_MASTER_NODENAME=sa8797
# Cloud A: display "Cloud A", real hostname cloud-01
VITE_AWS_AGENT1_NODENAME=cloud-01
# Cloud C: display "Cloud C", real hostname cloud-02
VITE_AWS_AGENT2_NODENAME=cloud-02
# Max time (ms) to wait for a node to join/leave after subscribe/unsubscribe. On timeout, show FAILED and roll back.
VITE_DEMO_SUBSCRIBE_TIMEOUT=60000
# ---------------------------------------------------------------------------

# ===========================================================================
# For Demo - AWS Agent Info. (used by the relay server server.ts)
#
#  How it works:
#   The dashboard backend only sends a signal (POST) to the AWS "trigger listener" URL.
#     Subscribe    -> POST <triggerUrl> {agentId, nodeName, action:"start"}
#     Unsubscribe  -> POST <triggerUrl> {agentId, nodeName, action:"stop"}
#   The AWS side receives the signal and starts/stops nodeagent itself, then joins master.
#   (The dashboard does NOT force remote commands over SSH.)
# ---------------------------------------------------------------------------
# UI flow test only = 1 (do not send requests, just log)
DEMO_DRY_RUN=0

# Per-request timeout (ms) for pharos/trigger POST calls in server.ts.
#   If unset, defaults to 30000 (30s). Increase if unsubscribe (stop/teardown) is slow
#   and you see "... timed out after ...ms" / "This operation was aborted".
#   NOTE: keep this <= VITE_DEMO_SUBSCRIBE_TIMEOUT so the UI doesn't roll back first.
DEMO_FETCH_TIMEOUT_MS=30000

# Unsubscribe (stop) ordering: cloud /trigger -> wait DEMO_STOP_DELAY_MS -> pharos /network.
#   pharos must be released AFTER cloud responds, because cutting the network first
#   prevents the cloud stop response from coming back. Default 3000 (3s) if unset.
DEMO_STOP_DELAY_MS=3000

# pharos-only test = 1 (send pharos /network for real, but SKIP the AWS /trigger step)
#   Use this when the AWS trigger endpoint is not ready yet but you want to verify pharos.
#   Requires DEMO_DRY_RUN=0 to actually send the pharos request.
#DEMO_SKIP_TRIGGER=1

# (Optional) Shared trigger auth token for all agents. If set, adds Authorization: Bearer <token> header.
# AWS_AGENT_TRIGGER_TOKEN=changeme

# ---------------------------------------------------------------------------
# pharos (HPC network manager)  * Called BEFORE the trigger on subscribe/unsubscribe.
#   Subscribe (start): (1) pharos /network -> (2) AWS /trigger
#   Unsubscribe (stop): (1) pharos /network -> (2) AWS /trigger
#   Body is the same as the trigger: { agentId, nodeName, action:"start"|"stop" }
#   The current IP/port/path (192.168.10.11:9000/network) is a placeholder.
#   NOTE: The dashboard runs on the local PC, but pharos lives on an HPC-internal
#   address (192.168.10.11) that is NOT directly routable from the local PC.
#   Use an SSH tunnel and point this URL at the tunnel entrance (localhost:9000):
#     ssh -p 1122 -N -L 9000:192.168.10.11:9000 root@10.231.178.134
# ---------------------------------------------------------------------------
PHAROS_NETWORK_URL=http://192.168.10.11:9000/network
#PHAROS_NETWORK_URL=http://127.0.0.1:9000/network
# (Optional) pharos auth token. If set, adds Authorization: Bearer <token> header.
# PHAROS_NETWORK_TOKEN=


# ---------------------------------------------------------------------------
# AWS instances (Aug-nissan-poc)  * The trigger "command (URL/method/body)" is not finalized yet.
#   Once finalized, update the *_TRIGGER_URL below and server.ts to match that spec.
#   The current path /trigger and port 9000 are placeholders.
#   The demo uses 2 clouds (display name -> real hostname):
#     Cloud A -> hostname cloud-01  (Aug-nissan-poc-01  ElasticIP 15.164.81.156)
#     Cloud C -> hostname cloud-02
# ---------------------------------------------------------------------------

# --- AWS Agent 1 = Cloud A (hostname cloud-01) ---
# (Server-side) AWS_AGENTx_NODENAME is used by server.ts for logging/identification.
# Keep identical to VITE_AWS_AGENTx_NODENAME above = the real hostname.
AWS_AGENT1_NODENAME=cloud-01
#AWS_AGENT1_TRIGGER_URL=http://15.164.81.156:9000/trigger
AWS_AGENT1_TRIGGER_URL=http://10.0.0.30:9000/trigger

# --- AWS Agent 2 = Cloud C (hostname cloud-02) ---
# Update TRIGGER_URL with the real endpoint once Cloud C is confirmed.
AWS_AGENT2_NODENAME=cloud-02
AWS_AGENT2_TRIGGER_URL=http://0.0.0.0:9000/trigger

# ===========================================================================
